rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ScriptHub community images
    match /community-images/{userId}/{fileName} {
      // Kartlarda herkes görebilsin.
      allow read: if true;

      // Sadece giriş yapan kullanıcı kendi klasörüne yükleyebilir.
      // Sadece resim ve 5 MB'a kadar.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Kullanıcı kendi yüklediği resmi silebilir.
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Diğer Storage yollarını kapat.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
