rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Community images: existing files remain readable forever.
    // New uploads are private to the authenticated owner for writes.
    match /community-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Profile/banner/avatar media.
    match /profile-media/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /cosmetic-media/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'WAtZhXqj2KUEib0RaRXMTOAgYpc2'
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/(mp4|webm)'));
      allow delete: if request.auth != null
        && request.auth.uid == 'WAtZhXqj2KUEib0RaRXMTOAgYpc2';
    }


    match /cosmetic-media/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'WAtZhXqj2KUEib0RaRXMTOAgYpc2'
        && userId == request.auth.uid
        && request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/(mp4|webm)')
        );
      allow delete: if request.auth != null
        && request.auth.uid == 'WAtZhXqj2KUEib0RaRXMTOAgYpc2'
        && userId == request.auth.uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}